[input_devices]

pointing/emulate_touch_from_mouse=true

[layer_names]

2d_physics/layer_1="particle"
2d_physics/layer_2="hero"
2d_physics/layer_3="saw"
2d_physics/layer_4="invisible_deadly"
2d_physics/layer_5="invisible_hidden"
2d_physics/layer_6="powerup"
2d_physics/layer_7="instant_powerup"
2d_physics/layer_8="hero_invincible"

[physics]

2d/default_gravity=0.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
viewport/hdr_2d=true
environment/defaults/default_clear_color=Color(0.03, 0.03, 0.06, 1)
